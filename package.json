{
  "name": "jb-git",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.31",
  "publisher": "hmc",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1f2838",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Humengchao/jb-git.git"
  },
  "homepage": "https://github.com/Humengchao/jb-git#readme",
  "bugs": {
    "url": "https://github.com/Humengchao/jb-git/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "version control",
    "changelist",
    "shelf",
    "idea"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git",
    "workspaceContains:**/.git"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run test:unit && npm run test:extension",
    "test:unit": "npm run compile && node scripts/run-unit-tests.mjs",
    "test:extension": "npm run compile && node test/run-extension-tests.mjs",
    "test:extension:min": "npm run compile && node test/run-extension-tests.mjs 1.95.0",
    "package": "npm run compile && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "jbGit.refresh",
        "title": "JB Git: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "jbGit.openChanges",
        "title": "JB Git: Open Local Changes"
      },
      {
        "command": "jbGit.openShelf",
        "title": "JB Git: Open Shelf"
      },
      {
        "command": "jbGit.openDiff",
        "title": "JB Git: Open Diff"
      },
      {
        "command": "jbGit.showHistory",
        "title": "JB Git: Show History"
      },
      {
        "command": "jbGit.openGitToolWindow",
        "title": "JB Git: Open Git Tool Window",
        "icon": "$(git-commit)"
      },
      {
        "command": "jbGit.branchesPopup",
        "title": "JB Git: Branches and Operations",
        "icon": "$(git-branch)"
      },
      {
        "command": "jbGit.operationsPopup",
        "title": "JB Git: Git Operations Popup",
        "icon": "$(ellipsis)"
      },
      {
        "command": "jbGit.fileHistory",
        "title": "JB Git: File History"
      },
      {
        "command": "jbGit.historyForSelection",
        "title": "JB Git: Show History for Selection"
      },
      {
        "command": "jbGit.compareWithBranch",
        "title": "JB Git: Compare with Branch…"
      },
      {
        "command": "jbGit.compareWithRevision",
        "title": "JB Git: Compare with Revision…"
      },
      {
        "command": "jbGit.blame",
        "title": "JB Git: Blame Active File"
      },
      {
        "command": "jbGit.toggleBlameAnnotations",
        "title": "JB Git: Annotate with Git Blame"
      },
      {
        "command": "jbGit.annotatePreviousRevision",
        "title": "JB Git: Annotate Previous Revision"
      },
      {
        "command": "jbGit.annotateRevision",
        "title": "JB Git: Annotate Revision"
      },
      {
        "command": "jbGit.copyRevisionNumber",
        "title": "JB Git: Copy Revision Number"
      },
      {
        "command": "jbGit.blameShowCommit",
        "title": "JB Git: Show Commit for Annotated Line"
      },
      {
        "command": "jbGit.blameHideRevision",
        "title": "JB Git: Hide Revision in Annotation"
      },
      {
        "command": "jbGit.blameShowHiddenRevisions",
        "title": "JB Git: Show Hidden Revisions in Annotation"
      },
      {
        "command": "jbGit.commit",
        "title": "JB Git: Commit Staged Changes"
      },
      {
        "command": "jbGit.pull",
        "title": "JB Git: Pull"
      },
      {
        "command": "jbGit.push",
        "title": "JB Git: Push"
      },
      {
        "command": "jbGit.createBranch",
        "title": "JB Git: Create Branch"
      },
      {
        "command": "jbGit.renameBranch",
        "title": "JB Git: Rename Branch"
      },
      {
        "command": "jbGit.deleteBranch",
        "title": "JB Git: Delete Branch"
      },
      {
        "command": "jbGit.stash",
        "title": "JB Git: Stash Changes"
      },
      {
        "command": "jbGit.createChangelist",
        "title": "JB Git: Create Changelist"
      },
      {
        "command": "jbGit.moveToChangelist",
        "title": "JB Git: Move to Changelist"
      },
      {
        "command": "jbGit.commitChangelist",
        "title": "JB Git: Commit Changelist"
      },
      {
        "command": "jbGit.merge",
        "title": "JB Git: Merge Ref"
      },
      {
        "command": "jbGit.rebase",
        "title": "JB Git: Rebase onto Ref"
      },
      {
        "command": "jbGit.interactiveRebase",
        "title": "JB Git: Interactively Rebase from Commit"
      },
      {
        "command": "jbGit.resolveSimpleConflicts",
        "title": "JB Git: Resolve Simple Conflicts"
      },
      {
        "command": "jbGit.cherryPick",
        "title": "JB Git: Cherry-pick Commit"
      },
      {
        "command": "jbGit.revert",
        "title": "JB Git: Revert Commit"
      },
      {
        "command": "jbGit.reset",
        "title": "JB Git: Reset to Ref"
      },
      {
        "command": "jbGit.continueOperation",
        "title": "JB Git: Continue Operation"
      },
      {
        "command": "jbGit.abortOperation",
        "title": "JB Git: Abort Operation"
      },
      {
        "command": "jbGit.skipOperation",
        "title": "JB Git: Skip Operation"
      },
      {
        "command": "jbGit.bisectStart",
        "title": "JB Git: Bisect Start"
      },
      {
        "command": "jbGit.bisectGood",
        "title": "JB Git: Bisect Good"
      },
      {
        "command": "jbGit.bisectBad",
        "title": "JB Git: Bisect Bad"
      },
      {
        "command": "jbGit.bisectSkip",
        "title": "JB Git: Bisect Skip"
      },
      {
        "command": "jbGit.bisectReset",
        "title": "JB Git: Bisect Reset"
      },
      {
        "command": "jbGit.createShelf",
        "title": "JB Git: Create Shelf"
      },
      {
        "command": "jbGit.applyShelf",
        "title": "JB Git: Apply Shelf"
      },
      {
        "command": "jbGit.deleteShelf",
        "title": "JB Git: Delete Shelf"
      },
      {
        "command": "jbGit.createWorktree",
        "title": "JB Git: Create Worktree"
      },
      {
        "command": "jbGit.manageWorktrees",
        "title": "JB Git: Manage Worktrees"
      },
      {
        "command": "jbGit.removeWorktree",
        "title": "JB Git: Remove Worktree"
      },
      {
        "command": "jbGit.pruneWorktrees",
        "title": "JB Git: Prune Worktrees"
      },
      {
        "command": "jbGit.updateSubmodules",
        "title": "JB Git: Update Submodules"
      },
      {
        "command": "jbGit.updateSubmodule",
        "title": "JB Git: Update Submodule"
      },
      {
        "command": "jbGit.manageSubmodules",
        "title": "JB Git: Manage Submodules"
      },
      {
        "command": "jbGit.createTag",
        "title": "JB Git: Create Tag"
      },
      {
        "command": "jbGit.deleteTag",
        "title": "JB Git: Delete Tag"
      },
      {
        "command": "jbGit.addRemote",
        "title": "JB Git: Add Remote"
      },
      {
        "command": "jbGit.manageRemotes",
        "title": "JB Git: Manage Remotes"
      },
      {
        "command": "jbGit.removeRemote",
        "title": "JB Git: Remove Remote"
      },
      {
        "command": "jbGit.setRemoteUrl",
        "title": "JB Git: Set Remote URL"
      },
      {
        "command": "jbGit.fetchRemote",
        "title": "JB Git: Fetch Remote"
      },
      {
        "command": "jbGit.pushRemote",
        "title": "JB Git: Push Remote"
      },
      {
        "command": "jbGit.applyStash",
        "title": "JB Git: Apply Stash"
      },
      {
        "command": "jbGit.manageStashes",
        "title": "JB Git: Manage Stashes"
      },
      {
        "command": "jbGit.popStash",
        "title": "JB Git: Pop Stash"
      },
      {
        "command": "jbGit.dropStash",
        "title": "JB Git: Drop Stash"
      },
      {
        "command": "jbGit.initializeRepository",
        "title": "JB Git: Initialize Repository"
      },
      {
        "command": "jbGit.cloneRepository",
        "title": "JB Git: Clone Repository"
      },
      {
        "command": "jbGit.fetch",
        "title": "JB Git: Fetch All Remotes"
      },
      {
        "command": "jbGit.applyPatch",
        "title": "JB Git: Apply Patch"
      },
      {
        "command": "jbGit.sparseCheckoutSet",
        "title": "JB Git: Configure Sparse Checkout"
      },
      {
        "command": "jbGit.sparseCheckoutDisable",
        "title": "JB Git: Disable Sparse Checkout"
      },
      {
        "command": "jbGit.lfsPull",
        "title": "JB Git: Pull LFS Objects"
      },
      {
        "command": "jbGit.checkoutBranch",
        "title": "JB Git: Checkout Branch"
      },
      {
        "command": "jbGit.stageChange",
        "title": "JB Git: Stage Change"
      },
      {
        "command": "jbGit.unstageChange",
        "title": "JB Git: Unstage Change"
      },
      {
        "command": "jbGit.stageHunk",
        "title": "JB Git: Stage Hunk"
      },
      {
        "command": "jbGit.unstageHunk",
        "title": "JB Git: Unstage Hunk"
      },
      {
        "command": "jbGit.discardChange",
        "title": "JB Git: Discard Change"
      },
      {
        "command": "jbGit.resolveConflict",
        "title": "JB Git: Open Merge Conflict Editor"
      },
      {
        "command": "jbGit.markResolved",
        "title": "JB Git: Mark Resolved"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "jbGit",
          "title": "Git",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "jbGit": [
        {
          "id": "jbGit.toolWindow",
          "name": "Git",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "jbGit.toggleBlameAnnotations",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "navigation@79"
        },
        {
          "command": "jbGit.blame",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "navigation@80"
        },
        {
          "command": "jbGit.fileHistory",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "navigation@81"
        }
      ],
      "editor/context": [
        {
          "command": "jbGit.fileHistory",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "jbGit@10"
        },
        {
          "command": "jbGit.historyForSelection",
          "when": "resourceScheme == file && editorHasSelection && jbGit.hasRepository",
          "group": "jbGit@10"
        },
        {
          "command": "jbGit.compareWithBranch",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "jbGit@14"
        },
        {
          "command": "jbGit.compareWithRevision",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "jbGit@15"
        },
        {
          "command": "jbGit.toggleBlameAnnotations",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "jbGit@11"
        },
        {
          "command": "jbGit.annotateRevision",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "jbGit@12"
        },
        {
          "command": "jbGit.blame",
          "when": "resourceScheme == file && jbGit.hasRepository",
          "group": "jbGit@13"
        }
      ],
      "explorer/context": [
        {
          "command": "jbGit.fileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder && jbGit.hasRepository",
          "group": "git@20"
        },
        {
          "command": "jbGit.compareWithBranch",
          "when": "resourceScheme == file && !explorerResourceIsFolder && jbGit.hasRepository",
          "group": "git@22"
        },
        {
          "command": "jbGit.compareWithRevision",
          "when": "resourceScheme == file && !explorerResourceIsFolder && jbGit.hasRepository",
          "group": "git@23"
        },
        {
          "command": "jbGit.blame",
          "when": "resourceScheme == file && !explorerResourceIsFolder && jbGit.hasRepository",
          "group": "git@21"
        }
      ],
      "commandPalette": [
        { "command": "jbGit.openDiff", "when": "false" },
        { "command": "jbGit.moveToChangelist", "when": "false" },
        { "command": "jbGit.commitChangelist", "when": "false" },
        { "command": "jbGit.applyShelf", "when": "false" },
        { "command": "jbGit.deleteShelf", "when": "false" },
        { "command": "jbGit.removeRemote", "when": "false" },
        { "command": "jbGit.fetchRemote", "when": "false" },
        { "command": "jbGit.pushRemote", "when": "false" },
        { "command": "jbGit.discardChange", "when": "false" },
        { "command": "jbGit.markResolved", "when": "false" },
        { "command": "jbGit.continueOperation", "when": "jbGit.canContinueOperation" },
        { "command": "jbGit.abortOperation", "when": "jbGit.canAbortOperation" },
        { "command": "jbGit.skipOperation", "when": "jbGit.canSkipOperation" },
        { "command": "jbGit.bisectGood", "when": "jbGit.operationKind == bisect" },
        { "command": "jbGit.bisectBad", "when": "jbGit.operationKind == bisect" },
        { "command": "jbGit.bisectSkip", "when": "jbGit.operationKind == bisect" },
        { "command": "jbGit.bisectReset", "when": "jbGit.operationKind == bisect" }
      ]
    },
    "keybindings": [
      {
        "command": "jbGit.openGitToolWindow",
        "key": "alt+9",
        "mac": "cmd+9",
        "when": "jbGit.hasRepository"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "jbGit.gitPath": {
          "type": "string",
          "default": "git",
          "description": "%configuration.gitPath%"
        },
        "jbGit.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoRefresh%"
        },
        "jbGit.refreshDebounceMs": {
          "type": "number",
          "default": 600,
          "minimum": 50,
          "maximum": 5000,
          "description": "%configuration.refreshDebounceMs%"
        },
        "jbGit.confirmDiscard": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.confirmDiscard%"
        },
        "jbGit.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master",
            "release/*"
          ],
          "description": "%configuration.protectedBranches%"
        },
        "jbGit.blame.showAuthor": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.blame.showAuthor%"
        },
        "jbGit.blame.showDate": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.blame.showDate%"
        },
        "jbGit.blame.showRevision": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.blame.showRevision%"
        },
        "jbGit.blame.dateFormat": {
          "type": "string",
          "enum": [
            "short",
            "relative"
          ],
          "default": "short",
          "description": "%configuration.blame.dateFormat%"
        },
        "jbGit.blame.maxAuthorWidth": {
          "type": "number",
          "default": 20,
          "minimum": 4,
          "maximum": 80,
          "description": "%configuration.blame.maxAuthorWidth%"
        },
        "jbGit.blame.heatMap": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.blame.heatMap%"
        },
        "jbGit.blame.highlightCommit": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.blame.highlightCommit%"
        },
        "jbGit.blame.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.blame.ignoreWhitespace%"
        },
        "jbGit.blame.detectMovementsWithinFile": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.blame.detectMovementsWithinFile%"
        },
        "jbGit.blame.detectMovementsAcrossFiles": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.blame.detectMovementsAcrossFiles%"
        },
        "jbGit.issueNavigation": {
          "type": "array",
          "restricted": true,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["pattern", "url"],
            "properties": {
              "pattern": {
                "type": "string",
                "maxLength": 512,
                "description": "%configuration.issueNavigation.pattern%"
              },
              "url": {
                "type": "string",
                "maxLength": 2048,
                "description": "%configuration.issueNavigation.url%"
              }
            }
          },
          "default": [],
          "description": "%configuration.issueNavigation%"
        }
      }
    }
  }
}
