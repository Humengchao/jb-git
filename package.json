{
  "name": "jb-git",
  "displayName": "JB Git",
  "description": "An IntelliJ IDEA-inspired Git workspace for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "version control",
    "changelist",
    "shelf",
    "idea"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run compile && node --test test/*.test.mjs",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "jbGit.refresh",
        "title": "JB Git: Refresh"
      },
      {
        "command": "jbGit.openChanges",
        "title": "JB Git: Open Local Changes"
      },
      {
        "command": "jbGit.openDiff",
        "title": "JB Git: Open Diff"
      },
      {
        "command": "jbGit.showHistory",
        "title": "JB Git: Show History"
      },
      {
        "command": "jbGit.showCommit",
        "title": "JB Git: Show Commit"
      },
      {
        "command": "jbGit.commit",
        "title": "JB Git: Commit Staged Changes"
      },
      {
        "command": "jbGit.pull",
        "title": "JB Git: Pull"
      },
      {
        "command": "jbGit.push",
        "title": "JB Git: Push"
      },
      {
        "command": "jbGit.createBranch",
        "title": "JB Git: Create Branch"
      },
      {
        "command": "jbGit.renameBranch",
        "title": "JB Git: Rename Branch"
      },
      {
        "command": "jbGit.deleteBranch",
        "title": "JB Git: Delete Branch"
      },
      {
        "command": "jbGit.stash",
        "title": "JB Git: Stash Changes"
      },
      {
        "command": "jbGit.createChangelist",
        "title": "JB Git: Create Changelist"
      },
      {
        "command": "jbGit.moveToChangelist",
        "title": "JB Git: Move to Changelist"
      },
      {
        "command": "jbGit.commitChangelist",
        "title": "JB Git: Commit Changelist"
      },
      {
        "command": "jbGit.merge",
        "title": "JB Git: Merge Ref"
      },
      {
        "command": "jbGit.rebase",
        "title": "JB Git: Rebase onto Ref"
      },
      {
        "command": "jbGit.cherryPick",
        "title": "JB Git: Cherry-pick Commit"
      },
      {
        "command": "jbGit.revert",
        "title": "JB Git: Revert Commit"
      },
      {
        "command": "jbGit.reset",
        "title": "JB Git: Reset to Ref"
      },
      {
        "command": "jbGit.continueOperation",
        "title": "JB Git: Continue Operation"
      },
      {
        "command": "jbGit.abortOperation",
        "title": "JB Git: Abort Operation"
      },
      {
        "command": "jbGit.skipOperation",
        "title": "JB Git: Skip Operation"
      },
      {
        "command": "jbGit.createShelf",
        "title": "JB Git: Create Shelf"
      },
      {
        "command": "jbGit.applyShelf",
        "title": "JB Git: Apply Shelf"
      },
      {
        "command": "jbGit.deleteShelf",
        "title": "JB Git: Delete Shelf"
      },
      {
        "command": "jbGit.createWorktree",
        "title": "JB Git: Create Worktree"
      },
      {
        "command": "jbGit.removeWorktree",
        "title": "JB Git: Remove Worktree"
      },
      {
        "command": "jbGit.pruneWorktrees",
        "title": "JB Git: Prune Worktrees"
      },
      {
        "command": "jbGit.updateSubmodules",
        "title": "JB Git: Update Submodules"
      },
      {
        "command": "jbGit.createTag",
        "title": "JB Git: Create Tag"
      },
      {
        "command": "jbGit.deleteTag",
        "title": "JB Git: Delete Tag"
      },
      {
        "command": "jbGit.addRemote",
        "title": "JB Git: Add Remote"
      },
      {
        "command": "jbGit.removeRemote",
        "title": "JB Git: Remove Remote"
      },
      {
        "command": "jbGit.setRemoteUrl",
        "title": "JB Git: Set Remote URL"
      },
      {
        "command": "jbGit.fetchRemote",
        "title": "JB Git: Fetch Remote"
      },
      {
        "command": "jbGit.pushRemote",
        "title": "JB Git: Push Remote"
      },
      {
        "command": "jbGit.applyStash",
        "title": "JB Git: Apply Stash"
      },
      {
        "command": "jbGit.popStash",
        "title": "JB Git: Pop Stash"
      },
      {
        "command": "jbGit.dropStash",
        "title": "JB Git: Drop Stash"
      },
      {
        "command": "jbGit.initializeRepository",
        "title": "JB Git: Initialize Repository"
      },
      {
        "command": "jbGit.fetch",
        "title": "JB Git: Fetch All Remotes"
      },
      {
        "command": "jbGit.checkoutBranch",
        "title": "JB Git: Checkout Branch"
      },
      {
        "command": "jbGit.stageChange",
        "title": "JB Git: Stage Change"
      },
      {
        "command": "jbGit.unstageChange",
        "title": "JB Git: Unstage Change"
      },
      {
        "command": "jbGit.discardChange",
        "title": "JB Git: Discard Change"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jbGit",
          "title": "Git Workspace",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "jbGit": [
        {
          "id": "jbGit.repositories",
          "name": "Repositories",
          "when": "jbGit.hasWorkspace"
        },
        {
          "id": "jbGit.changes",
          "name": "Local Changes",
          "when": "jbGit.hasWorkspace"
        },
        {
          "id": "jbGit.history",
          "name": "History",
          "when": "jbGit.hasWorkspace"
        },
        {
          "id": "jbGit.changelists",
          "name": "Changelists",
          "when": "jbGit.hasWorkspace"
        },
        {
          "id": "jbGit.shelves",
          "name": "Shelf",
          "when": "jbGit.hasWorkspace"
        },
        {
          "id": "jbGit.worktrees",
          "name": "Worktrees",
          "when": "jbGit.hasWorkspace"
        },
        {
          "id": "jbGit.remotes",
          "name": "Remotes",
          "when": "jbGit.hasWorkspace"
        },
        {
          "id": "jbGit.stashes",
          "name": "Stashes",
          "when": "jbGit.hasWorkspace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jbGit.refresh",
          "when": "view == jbGit.repositories || view == jbGit.changes || view == jbGit.history || view == jbGit.changelists || view == jbGit.shelves || view == jbGit.worktrees || view == jbGit.remotes || view == jbGit.stashes",
          "group": "navigation@1"
        },
        {
          "command": "jbGit.fetch",
          "when": "view == jbGit.repositories",
          "group": "navigation@2"
        },
        {
          "command": "jbGit.commit",
          "when": "view == jbGit.changes",
          "group": "navigation@2"
        },
        {
          "command": "jbGit.push",
          "when": "view == jbGit.repositories",
          "group": "navigation@3"
        },
        {
          "command": "jbGit.pull",
          "when": "view == jbGit.repositories",
          "group": "navigation@4"
        },
        {
          "command": "jbGit.showHistory",
          "when": "view == jbGit.history",
          "group": "navigation@2"
        },
        {
          "command": "jbGit.createChangelist",
          "when": "view == jbGit.changelists",
          "group": "navigation@2"
        },
        {
          "command": "jbGit.commitChangelist",
          "when": "view == jbGit.changelists",
          "group": "navigation@3"
        },
        {
          "command": "jbGit.createShelf",
          "when": "view == jbGit.shelves",
          "group": "navigation@2"
        },
        {
          "command": "jbGit.createWorktree",
          "when": "view == jbGit.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "jbGit.pruneWorktrees",
          "when": "view == jbGit.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "jbGit.addRemote",
          "when": "view == jbGit.remotes",
          "group": "navigation@2"
        },
        {
          "command": "jbGit.stash",
          "when": "view == jbGit.stashes",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jbGit.createBranch",
          "when": "view == jbGit.repositories && (viewItem == jbGit.repository || viewItem == jbGit.branch)",
          "group": "inline@1"
        },
        {
          "command": "jbGit.renameBranch",
          "when": "view == jbGit.repositories && viewItem == jbGit.branch",
          "group": "inline@2"
        },
        {
          "command": "jbGit.deleteBranch",
          "when": "view == jbGit.repositories && viewItem == jbGit.branch",
          "group": "inline@3"
        },
        {
          "command": "jbGit.openDiff",
          "when": "view == jbGit.changes && viewItem == jbGit.change.unstaged",
          "group": "inline@0"
        },
        {
          "command": "jbGit.stageChange",
          "when": "view == jbGit.changes && viewItem == jbGit.change.unstaged",
          "group": "inline@1"
        },
        {
          "command": "jbGit.unstageChange",
          "when": "view == jbGit.changes && viewItem == jbGit.change.staged",
          "group": "inline@1"
        },
        {
          "command": "jbGit.discardChange",
          "when": "view == jbGit.changes && viewItem == jbGit.change.unstaged",
          "group": "inline@2"
        },
        {
          "command": "jbGit.moveToChangelist",
          "when": "view == jbGit.changelists && viewItem == jbGit.changelist.change",
          "group": "inline@1"
        },
        {
          "command": "jbGit.openDiff",
          "when": "view == jbGit.changelists && viewItem == jbGit.changelist.change",
          "group": "inline@0"
        },
        {
          "command": "jbGit.commitChangelist",
          "when": "view == jbGit.changelists && (viewItem == jbGit.changelist || viewItem == jbGit.changelist.active)",
          "group": "inline@1"
        },
        {
          "command": "jbGit.applyShelf",
          "when": "view == jbGit.shelves && viewItem == jbGit.shelf",
          "group": "inline@1"
        },
        {
          "command": "jbGit.deleteShelf",
          "when": "view == jbGit.shelves && viewItem == jbGit.shelf",
          "group": "inline@2"
        },
        {
          "command": "jbGit.removeWorktree",
          "when": "view == jbGit.worktrees && (viewItem == jbGit.worktree || viewItem == jbGit.worktree.prunable)",
          "group": "inline@1"
        },
        {
          "command": "jbGit.fetchRemote",
          "when": "view == jbGit.remotes && viewItem == jbGit.remote",
          "group": "inline@0"
        },
        {
          "command": "jbGit.pushRemote",
          "when": "view == jbGit.remotes && viewItem == jbGit.remote",
          "group": "inline@1"
        },
        {
          "command": "jbGit.setRemoteUrl",
          "when": "view == jbGit.remotes && viewItem == jbGit.remote",
          "group": "inline@2"
        },
        {
          "command": "jbGit.removeRemote",
          "when": "view == jbGit.remotes && viewItem == jbGit.remote",
          "group": "inline@3"
        },
        {
          "command": "jbGit.applyStash",
          "when": "view == jbGit.stashes && viewItem == jbGit.stash",
          "group": "inline@0"
        },
        {
          "command": "jbGit.popStash",
          "when": "view == jbGit.stashes && viewItem == jbGit.stash",
          "group": "inline@1"
        },
        {
          "command": "jbGit.dropStash",
          "when": "view == jbGit.stashes && viewItem == jbGit.stash",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "JB Git",
      "properties": {
        "jbGit.gitPath": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "jbGit.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh repository state when files or Git metadata change."
        },
        "jbGit.refreshDebounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 5000,
          "description": "Debounce interval for repository refreshes."
        },
        "jbGit.confirmDiscard": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before discarding changes."
        }
      }
    }
  }
}
